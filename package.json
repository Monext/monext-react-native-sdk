{
  "name": "monext-react-native-sdk",
  "version": "0.2.0",
  "description": "React Native wrapper for the Monext iOS and Android payment sheets.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "android",
    "!android/build/**",
    "!android/local.properties",
    "ios",
    "monext-react-native-sdk.podspec",
    "src",
    "lib",
    "README.md"
  ],
  "scripts": {
    "android": "npm --prefix example-app run android",
    "ios": "npm --prefix example-app run ios",
    "start": "npm --prefix example-app run start",
    "typecheck": "tsc --noEmit",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "android",
    "ios",
    "turbo-module",
    "monext",
    "payment"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native/metro-config": "^0.86.2",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-native": "^0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^5.8.0"
  },
  "codegenConfig": {
    "name": "RNMonextPaymentSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.monext.reactnative"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
