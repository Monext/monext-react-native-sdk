{
  "name": "monext-react-native-sdk",
  "version": "0.2.2",
  "description": "React Native wrapper for the Monext iOS and Android payment sheets.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Monext/monext-react-native-sdk.git"
  },
  "homepage": "https://github.com/Monext/monext-react-native-sdk#readme",
  "bugs": {
    "url": "https://github.com/Monext/monext-react-native-sdk/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "android",
    "!android/build",
    "!android/build/**",
    "!android/.gradle",
    "!android/.gradle/**",
    "!android/.idea",
    "!android/.idea/**",
    "!android/local.properties",
    "!android/src/test",
    "!android/src/test/**",
    "ios",
    "monext-react-native-sdk.podspec",
    "src",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "android": "npm --prefix example-app run android",
    "ios": "npm --prefix example-app run ios",
    "start": "npm --prefix example-app run start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "android",
    "ios",
    "turbo-module",
    "monext",
    "payment"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "^0.86.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react": "^19.2.8",
    "react-native": "^0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "react-test-renderer": "19.2.8",
    "typescript": "^5.8.0"
  },
  "codegenConfig": {
    "name": "RNMonextPaymentSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.monext.reactnative"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
